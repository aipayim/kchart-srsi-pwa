{
  "name": "smart-trader",
  "version": "1.5.1",
  "description": "智能交易系统 v1.0 - 纸面交易引擎（双所行情 + 事件溯源持久化 + 可验证一致性）",
  "type": "module",
  "scripts": {
    "version:gen": "node scripts/gen-version.mjs",
    "release": "node scripts/release.mjs",
    "predev": "node scripts/gen-version.mjs",
    "prebuild": "node scripts/gen-version.mjs",
    "dev": "vite",
    "build": "node scripts/gen-version.mjs && node scripts/gen-icon.mjs && vite build",
    "pwa:icons": "node scripts/gen-icon.mjs",
    "preview": "vite preview",
    "test": "node tests/kchart.test.mjs && node tests/consistency.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
